# QVAC model files (downloaded at runtime, never committed)
*.gguf
# …except the bundled LoRA adapters (the fine-tune that ships IN the APK) —
# tracked via Git LFS (see .gitattributes).
!packages/mobile/assets/models/*.gguf
model-cache/

# LoRA training output
finetuning/lora-output/

# References (raw curriculum materials — large, not for repo)
references/curriculum/
references/modules/

# Logs
*.log

# Turbo
.turbo/

# Claude Code local state + worktrees (never committed)
.claude/

# local app database (kept out of git)
data/
# …but the mobile and web app's bundled source data (factoid bank) IS committed
!packages/mobile/src/data/
!packages/mobile/src/data/**
!packages/web/src/data/
!packages/web/src/data/**
deploy/models/
deploy/llama.cpp/
deploy/llama-bin/

