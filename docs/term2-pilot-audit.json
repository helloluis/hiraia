  "corrections": [
    {
      "id": "ffct-24623",
      "factId": "chinese-garter-jump-g4",
      "reason": "Elastic deformation stores energy, not force.",
      "source": "https://openstax.org/books/college-physics/pages/7-4-conservative-forces-and-potential-energy"
    },
    {
      "id": "ffct-22440",
      "factId": "force-direction-matters-g4",
      "reason": "A net force changes velocity; motion need not immediately follow the applied force.",
      "source": "https://openstax.org/books/physics/pages/4-3-newtons-second-law-of-motion"
    },
    {
      "id": "ffct-23371",
      "factId": "force-has-direction-g4",
      "reason": "A net force changes velocity; motion need not immediately follow the applied force.",
      "source": "https://openstax.org/books/physics/pages/4-3-newtons-second-law-of-motion"
    },
    {
      "id": "ffct-24137",
      "factId": "force-friction-direction-opposes-g5",
      "reason": "Limit the opposing-motion claim to sliding relative to a stationary surface.",
      "source": "https://openstax.org/books/physics/pages/5-1-friction"
    },
    {
      "id": "ffct-27000",
      "factId": "fwg-pulley-work-1558",
      "reason": "A single fixed pulley does not multiply force; distinguish arrangements.",
