 "purpose": "Speech-only pronunciations for Hiraia's own names, shared by the main Hiraia APK, the Reader APK and the hiraia.org voice demo. Changes audio only; displayed text is never rewritten.",
 "approval": {
  "date": "2026-11-24",
  "by": "Luis Buenaventura",
  "record": "Luis specified Hiraia = Hee-RA-ya and QVAC = CUE-vak, then accepted the proposed set after the local A/B page ('Those sound correct to me'). This does not record that every clip was heard."
 },
 "runtime_notes": "status uses the strictest runtime schema (website Python: draft|source_checked|native_reviewed). Tagalog overrides need annotation_scope and source. Rewrites use only regex syntax shared by Python re and JavaScript (case-insensitive, no backreferences) and run in order before text normalisation.",
 "speech_text_rewrites": [
  {
   "id": "url-scheme",
   "pattern": "\\bhttps?://(?=(?:[a-z0-9-]+\\.)*hiraia\\.org\\b)",
   "replacement": "",
   "status": "draft",
   "notes": "drop the scheme of a hiraia.org URL"
  },
  {
   "id": "url-subdomain-dots",
   "pattern": "\\.(?=(?:[a-z0-9-]+\\.)*hiraia\\.org\\b)",
   "replacement": " dot ",
   "status": "draft",
   "notes": "www.hiraia.org / assets.hiraia.org"
  },
  {
   "id": "hiraia-org",
   "pattern": "\\bhiraia\\.org\\b",
   "replacement": "Hiraia dot org",
   "status": "draft"
  }
 ],
