# Files EAS should NOT upload for the mobile build. The Android build only needs
# the JS workspace (packages/*) — the curated facts are already compiled into
# packages/shared/src/rag/facts.generated.ts.
#
# IMPORTANT: anchor every entry with a leading slash so it matches ONLY the repo
# root. An unanchored "rag/" also matched packages/shared/src/rag/ (the RagStore!)
# and stripped it from the EAS upload — breaking the JS bundle. Likewise do NOT
# blanket-ignore *.gguf: the bundled LoRA adapters live at
# packages/mobile/assets/models/*.gguf and MUST be uploaded.

# ML training: adapters, datasets, eval dumps (hundreds of MB, untracked)
/finetuning/

# VPS deploy: llama.cpp build + GGUF models (multi-GB)
/deploy/

# RAG corpus + framework PDFs + SQLite build artifact (root only — NOT the
# shared package's src/rag/)
/rag/

# Raw curriculum materials
/references/

# Stray data file
/science-chat.jsonl

# Image library asset BLOBS (~1.2GB) — the mobile app does NOT bundle these
# (image retrieval is server-side / deferred). Keep the @hiraia/images PACKAGE
# itself (src, package.json, index.json) so pnpm workspace resolution still
# works — exclude ONLY the big generated PNG/raster dirs.
/packages/images/assets-png/
/packages/images/gemini-queue/
/packages/images/samples/
/packages/images/pilot/

# Mobile build output (regenerated by EAS; not a source input)
/packages/mobile/dist/
