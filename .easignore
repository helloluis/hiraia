# Files EAS should NOT upload for the mobile build. The Android build only needs
# the JS workspace (packages/*) — the curated facts are already compiled into
# packages/mobile/assets/data/cards.db, which lives inside that workspace.
#
# IMPORTANT: anchor every entry with a leading slash so it matches ONLY the repo
# root. An unanchored "rag/" also matched packages/shared/src/rag/ (the RagStore!)
# and stripped it from the EAS upload — breaking the JS bundle.

# ML training: adapters, datasets, eval dumps (hundreds of MB, untracked)
/finetuning/

# VPS deploy: llama.cpp build + GGUF models (multi-GB)
/deploy/

# RAG corpus + framework PDFs + SQLite build artifact (root only — NOT the
# shared package's src/rag/).
#
# This still holds now that the fact bank's source of truth (rag/bank/science-facts.jsonl) is
# what Node reads: the APP does not read it. It reads the compiled `fact` tables inside
# packages/mobile/assets/data/cards.db, and the loader that touches the JSONL
# (packages/shared/src/rag/bankFile.ts) needs node:fs, so it is deliberately kept OUT of the
# shared barrel and reachable only via the separate `@hiraia/shared/node` entry point. Nothing
# in the Metro graph resolves it.
/rag/

# Raw curriculum materials
/references/

# Stray data file
/science-chat.jsonl

# Image library: the mobile app NOW bundles assets-png (512x512 PNGs) via the
# generated imageMap — so it must be uploaded. Exclude only the heavy raw originals
# backup and the unused raster dirs.
/packages/images/assets-png-raw/
/packages/images/gemini-queue/
/packages/images/samples/
/packages/images/pilot/

# Mobile build output (regenerated by EAS; not a source input)
/packages/mobile/dist/

# The LoRA adapters (213.5 MB). They are no longer bundled: Metro does not treat
# .gguf as an asset any more and nothing imports them, so they are DOWNLOADED from
# https://hiraia.b11.dev/models/ and verified against a declared size + MD5
# (packages/mobile/src/config/model.ts REMOTE_ASSETS). The local files stay on disk
# because they are the exact bytes uploaded to that mirror — they are just not a
# build input, and uploading them to EAS is 213.5 MB of dead weight per build.
/packages/mobile/assets/models/
