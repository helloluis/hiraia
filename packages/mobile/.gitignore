# QVAC on-device worker bundle — regenerated by `expo prebuild` (withMobileBundle
# config plugin). Build artifact; do not commit. ~10 MB bundle + addons manifest.
/qvac/

# local scratch dir for copied-out release APKs (the build itself leaves the APK
# under android/app/build/outputs/ — see scripts/build-apk.sh)
apk-out/
scripts/card-harness-report.txt

# release-signing key material fetched from EAS by `eas credentials -p android`
# (consumed by scripts/sign-apk.sh) — NEVER commit
credentials.json
keystores/
*.jks
*.keystore
!android/app/debug.keystore
