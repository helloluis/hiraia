{
  "expo": {
    "name": "Hiraia",
    "slug": "hiraia",
    "version": "0.4.16",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "hiraia",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C3B2E"
    },
    "androidStatusBar": {
      "backgroundColor": "#1C3B2E",
      "barStyle": "light-content"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hiraia.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C3B2E"
      },
      "package": "com.hiraia.app",
      "versionCode": 16,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "./plugins/withGradleProps.js",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "./plugins/withQvacAddons.js",
      "@qvac/sdk/expo-plugin",
      "expo-asset",
      "expo-video",
      "./plugins/withTelemetryBackup.js",
      [
        "expo-splash-screen",
        {
          "android": {
            "image": "./assets/splash.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#1C3B2E"
          }
        }
      ],
      "./plugins/withHiraiaMemory.js",
      "./plugins/withOnnxruntime.js",
      "./plugins/withBundledIllustrations.js",
      "./plugins/withTalaNearby.js",
      [
        "expo-camera",
        {
          "cameraPermission": "Hiraia uses the camera to scan the teacher QR for classroom sync."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f272b8f-50b8-48b9-996c-12f4a94863fb"
      }
    },
    "owner": "cryptoday"
  }
}
