         std::vector<fs::path> names = { name_path };
 #ifdef __ANDROID__
         if (strcmp(name, "cpu") == 0) {
+#if defined(__x86_64__)
+            // Android's linker can resolve APK-embedded libraries by name, but
+            // filesystem enumeration cannot see them. Keep the baseline for
+            // older Intel/AMD Chromebooks; each variant checks CPUID before use.
+            for (const char * variant : {
+                     "x64", "sse42", "sandybridge", "ivybridge", "piledriver",
