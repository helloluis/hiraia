# Public model-server URL baked into the client at build time.
# (nginx proxies https://hiraia.b11.dev/qvac/ -> llama-server :8080)
NEXT_PUBLIC_QVAC_URL=https://hiraia.b11.dev/qvac

# thirdweb client ID for the /support crypto checkout (public by design; the thirdweb project
# "Hiraia" locks it to https://hiraia.org). Anything other than a 32-character hex ID keeps the
# checkout closed and the page shows the address only.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=897f11e5f997baa2edd3ab2d5e0335fc
