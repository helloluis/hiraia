# Public model-server URL baked into the client at build time.
# (nginx proxies https://hiraia.b11.dev/qvac/ -> llama-server :8080)
NEXT_PUBLIC_QVAC_URL=https://hiraia.b11.dev/qvac

# thirdweb client ID for the /support crypto checkout (public; lock it to hiraia.org in the
# thirdweb dashboard). PLACEHOLDER until Luis creates the thirdweb project: while this is not
# a 32-character hex client ID the checkout stays closed and the page shows the address only.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=PLACEHOLDER_PASTE_THIRDWEB_CLIENT_ID
