{
  "name": "@hiraia/tala-web",
  "version": "0.1.0",
  "private": true,
  "description": "Tala web app for tala.hiraia.org: Next.js 15 App Router, Hiraia branding, mounts @hiraia/tala-server at /api/v1.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
