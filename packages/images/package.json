{
  "name": "@hiraia/images",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "qc": "tsx pilot/qc-server.mjs",
    "normalize": "svgo --config svgo.config.mjs -rqf assets && svgo --config svgo.config.mjs -rqf pilot",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@hiraia/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
