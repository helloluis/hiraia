        },
        "gen": {
          "provider": "deepseek",
          "model": "deepseek-flash",
          "promptId": "lesson/week",
          "promptVersion": 3,
          "curriculumVersion": "eval.v1",
          "at": "2026-11-16T00:00:00.000Z"
        }
      },
      {
        "key": "weekgrid",
        "content": {
          "type": "weekgrid",
          "days": [
            {
              "date": null,
              "weekday": 1,
              "minutes": 40,
              "body": [
                {
                  "t": "p",
                  "spans": [
                    {
                      "text": "Pagmasdan ang mga halaman sa paligid ng silid-aralan. Sa pares, magtala ng tatlong bagay na napapansin sa isang halaman gamit ang papel at lapis."
                    }
                  ]
                }
              ]
            },
            {
              "date": null,
              "weekday": 2,
              "minutes": 40,
              "body": [
                {
                  "t": "p",
                  "spans": [
                    {
                      "text": "Tukuyin ang mga bahagi ng halaman sa isang guhit. Gumawa ng malaking guhit sa papel at pangalanan ang ugat, tangkay, at dahon."
                    }
                  ]
                }
              ]
            },
            {
              "date": null,
              "weekday": 3,
              "minutes": 40,
              "body": [
                {
                  "t": "p",
                  "spans": [
                    {
                      "text": "Ilarawan ang hugis, kulay, at laki ng mga dahon. Sa pares, ikuwento sa kapareha ang pagkakaiba ng dalawang dahon na nakita."
                    }
                  ]
                }
              ]
            },
            {
              "date": null,
              "weekday": 4,
              "minutes": 40,
              "body": [
                {
                  "t": "p",
                  "spans": [
                    {
                      "text": "Ihambing ang dalawang halaman na nakita sa paligid. Isulat o iguhit sa papel ang pagkakatulad at pagkakaiba ng mga ito."
                    }
                  ]
                }
              ]
            },
            {
              "date": null,
              "weekday": 5,
              "minutes": 40,
              "body": [
                {
                  "t": "p",
                  "spans": [
                    {
                      "text": "Ilarawan ang isang halaman sa pamamagitan ng guhit at maikling pangungusap. Ipakita sa klase ang ginawa at sabihin ang mga bahagi nito."
                    }
                  ]
                }
              ]
            }
          ]
        },
        "gen": {
          "provider": "deepseek",
