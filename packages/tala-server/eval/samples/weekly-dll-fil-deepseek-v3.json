                {
                  "t": "p",
                  "spans": [
                    {
                      "text": "Pagmamasid sa mga halaman sa paligid ng silid-aralan. Sa mga pares, maglarawan ng isang halaman gamit ang pandama (hugis, kulay, laki) at ibahagi sa klase ang isang obserbasyon."
                    }
                  ]
                }
              ]
            },
            {
              "date": null,
              "weekday": 2,
              "minutes": 40,
              "body": [
                {
                  "t": "p",
                  "spans": [
                    {
                      "text": "Pag-aaral ng mga bahagi ng halaman (ugat, tangkay, dahon). Sa mga pares, gumuhit ng isang halaman at lagyan ng tsek ang mga bahaging nakikita; magbahagi ng isang bahagi at ang hitsura nito."
                    }
                  ]
                }
              ]
            },
            {
              "date": null,
              "weekday": 3,
              "minutes": 40,
              "body": [
                {
                  "t": "p",
                  "spans": [
                    {
                      "text": "Paglalarawan ng hugis at tekstura ng ugat, tangkay, at dahon. Sa mga pares, gumawa ng tsart ng obserbasyon sa isang papel (hati-hatiin) at itala ang kulay at hugis ng bawat bahagi."
                    }
                  ]
                }
              ]
            },
            {
              "date": null,
              "weekday": 4,
              "minutes": 40,
              "body": [
                {
                  "t": "p",
                  "spans": [
                    {
                      "text": "Paghahambing ng dalawang halaman na napagmasdan. Sa mga pares, gumuhit ng dalawang halaman at maglagay ng dalawang pagkakatulad at dalawang pagkakaiba sa ilalim ng guhit."
                    }
                  ]
                }
              ]
            },
            {
              "date": null,
              "weekday": 5,
              "minutes": 40,
              "body": [
                {
                  "t": "p",
                  "spans": [
                    {
                      "text": "Pagtatasa: bawat pares ay gaguhit ng isang halaman, lalagyan ng pangalan ang ugat, tangkay, at dahon, at lalarawan ang bawat bahagi nang pasalita sa guro."
                    }
                  ]
                }
              ]
            }
