              "groups": {
                "group-002": {
                  "mode": "shared",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Say the name of a plant you know and point to one part you remember."
                        }
                      ]
                    }
                  ]
                },
                "group-004": {
                  "mode": "shared",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Share with a partner one plant part and what you think it does for the plant."
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "id": "5a71d845-9f7a-4b7b-ba0e-61558f901386",
              "label": "Teach Grade 2",
              "minutes": 20,
              "transitionMinutes": 1,
              "teacherWith": "group-002",
              "pairedGroupIds": [],
              "groups": {
                "group-002": {
                  "mode": "direct",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "With the teacher, look at a plant picture or plant part and name roots, stem, and leaves; then point to each part on your own drawing."
                        }
                      ]
                    }
                  ]
                },
                "group-004": {
                  "mode": "independent",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Working unaided, draw a plant on paper and label roots, stem, leaves, and flower; beside each label write one sentence about what that part does."
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "id": "0d23e547-f1eb-4cf7-b4e6-1c5f94b33575",
              "label": "Teach Grade 4",
              "minutes": 20,
              "transitionMinutes": 1,
              "teacherWith": "group-004",
              "pairedGroupIds": [],
              "groups": {
                "group-002": {
                  "mode": "independent",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Working unaided, fold a paper into four boxes and draw one plant part in each box: roots, stem, leaf, flower; say the name quietly as you draw."
                        }
                      ]
                    }
                  ]
                },
                "group-004": {
                  "mode": "direct",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "With the teacher, explain how roots, stem, leaves, and flower help a plant live and grow, using your labeled drawing as a guide."
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "id": "3fcf00a3-4c4e-4d92-bc3c-e5e6924a007d",
              "label": "Closing",
              "minutes": 5,
              "transitionMinutes": 0,
              "teacherWith": "all",
              "pairedGroupIds": [],
              "groups": {
                "group-002": {
                  "mode": "shared",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Show your four-box drawing and name two plant parts."
                        }
                      ]
                    }
                  ]
                },
                "group-004": {
                  "mode": "shared",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Show your labeled drawing and explain one plant part and how it helps the plant."
                        }
                      ]
                    }
                  ]
                }
              }
            }
