              "groups": {
                "group-002": {
                  "mode": "direct",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Teacher shows and names plant parts one by one; learners point and repeat, then draw one labeled plant on paper."
                        }
                      ]
                    }
                  ]
                },
                "group-004": {
                  "mode": "independent",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Unaided: draw a plant from memory and write two sentences describing its parts; then list three describing words you used."
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "id": "f9cd65e3-11e8-4e99-992e-0aa3e05731f6",
              "label": "Teach grade 4",
              "minutes": 20,
              "transitionMinutes": 1,
