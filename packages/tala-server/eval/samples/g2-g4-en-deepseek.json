                  ]
                },
                "group-004": {
                  "mode": "shared",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Say one plant you know and describe one part of it in a full sentence."
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "id": "325ad2f3-0a66-499a-ab48-1a40ab2c2445",
