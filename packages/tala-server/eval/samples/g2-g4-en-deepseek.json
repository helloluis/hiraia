              "groups": {
                "group-002": {
                  "mode": "independent",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Unaided: finish coloring and labeling your plant drawing, then write one word for each part you drew."
                        }
                      ]
                    }
                  ]
                },
                "group-004": {
                  "mode": "direct",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Teacher models describing a plant in detail; learners add two more sentences comparing two plant parts and share one with the teacher."
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "id": "6251d43f-e9d2-4b4e-9848-140c0e2a2005",
