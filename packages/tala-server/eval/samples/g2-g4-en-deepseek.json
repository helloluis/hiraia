              "groups": {
                "group-002": {
                  "mode": "shared",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Show your drawing and name two plant parts you drew."
                        }
                      ]
                    }
                  ]
                },
                "group-004": {
                  "mode": "shared",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
