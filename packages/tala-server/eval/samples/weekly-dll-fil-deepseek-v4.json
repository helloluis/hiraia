                {
                  "t": "p",
                  "spans": [
                    {
                      "text": "Maglakbay-tanaw sa mga halaman sa labas; gumuhit ng isang halaman sa papel at pangalanan ang mga bahaging nakikita. Pag-uusap tungkol sa mga bahagi ng halaman."
                    }
                  ]
                }
              ]
            },
            {
              "date": null,
              "weekday": 2,
              "minutes": 40,
              "body": [
                {
                  "t": "p",
                  "spans": [
                    {
                      "text": "Sa pares, ilarawan ang hugis at kulay ng dahon at ugat ng halamang iginuhit kahapon; idagdag ang mga bahaging nakalimutan."
                    }
                  ]
                }
              ]
            },
            {
              "date": null,
              "weekday": 3,
              "minutes": 40,
              "body": [
                {
                  "t": "p",
                  "spans": [
                    {
                      "text": "Ihambing ang dalawang halaman gamit ang tsart ng pagkakaiba (laki, hugis ng dahon, kulay) na iginuhit sa papel."
                    }
                  ]
                }
              ]
            },
            {
              "date": null,
              "weekday": 4,
              "minutes": 40,
              "body": [
                {
                  "t": "p",
                  "spans": [
                    {
                      "text": "Pangkatang laro: ilarawan ang isang halaman nang hindi pinapangalanan ito; hulaan ng kaklase batay sa mga bahagi at katangiang inilarawan."
                    }
                  ]
                }
              ]
            },
            {
              "date": null,
              "weekday": 5,
              "minutes": 40,
              "body": [
                {
                  "t": "p",
                  "spans": [
                    {
                      "text": "Indibidwal na gawain: gumuhit ng halaman at isulat ang isang pangungusap na naglalarawan dito gamit ang papel at lapis."
                    }
                  ]
                }
              ]
            }
          ]
