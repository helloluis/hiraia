          "type": "multigrade",
          "blocks": [
            {
              "id": "55dd540e-93f3-476a-a2c8-80ab4af778f7",
              "label": "Shared opening",
              "minutes": 5,
              "transitionMinutes": 0,
              "teacherWith": "all",
              "pairedGroupIds": [],
              "groups": {
                "group-002": {
                  "mode": "shared",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Look at a plant outside or a plant you remember; whisper the names of parts you can see to a partner."
                        }
                      ]
                    }
                  ]
                },
                "group-004": {
                  "mode": "shared",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Look at the same plant and think of one job each part might do; whisper one idea to a partner."
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "id": "3d9a179f-e1c5-4ca0-89a9-d1368a00caf5",
              "label": "Direct teaching for Grade 2",
              "minutes": 20,
              "transitionMinutes": 1,
              "teacherWith": "group-002",
              "pairedGroupIds": [],
              "groups": {
                "group-002": {
                  "mode": "direct",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "With the teacher, point to and name each plant part on a drawing and say one word that describes it, such as green, long, or thin."
                        }
                      ]
                    }
                  ]
                },
                "group-004": {
                  "mode": "independent",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "On your own sheet, draw a plant and write one sentence for each part telling how it helps the plant; then trade with a partner and add one missing idea."
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "id": "be250dab-6ee0-448c-a575-4e571df1a188",
              "label": "Direct teaching for Grade 4",
              "minutes": 20,
              "transitionMinutes": 1,
              "teacherWith": "group-004",
              "pairedGroupIds": [],
              "groups": {
                "group-002": {
                  "mode": "independent",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "On your own sheet, draw one plant and label each part; then pair up with one classmate and describe your plant out loud."
                        }
                      ]
                    }
                  ]
                },
                "group-004": {
                  "mode": "direct",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "With the teacher, explain how each plant part helps the plant and answer the teacher's questions about your drawing."
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "id": "b152e7af-d885-4ff7-bda9-72ead3c53c62",
              "label": "Shared closing",
              "minutes": 5,
              "transitionMinutes": 0,
              "teacherWith": "all",
              "pairedGroupIds": [],
              "groups": {
                "group-002": {
                  "mode": "shared",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Share one describing word for a plant part with the class."
                        }
                      ]
                    }
                  ]
                },
                "group-004": {
                  "mode": "shared",
                  "activity": [
                    {
                      "t": "p",
                      "spans": [
                        {
                          "text": "Share one way a plant part helps the plant with the class."
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
