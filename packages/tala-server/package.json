{
  "name": "@hiraia/tala-server",
  "version": "0.1.0",
  "private": true,
  "description": "Tala API server: kernel + modules. Framework-agnostic (Web Fetch Request -> Response); mounted by tala-web.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./kernel": "./src/kernel/types.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "dev": "tsx watch src/dev-server.ts"
  },
  "dependencies": {
    "@hiraia/tala-core": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "better-sqlite3": "^12.10.0",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "saxes": "^6.0.0",
    "tsx": "^4.19.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.29",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
