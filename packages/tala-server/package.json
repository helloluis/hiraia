{
  "name": "@hiraia/tala-server",
  "version": "0.1.0",
  "private": true,
  "description": "Tala API server: kernel + modules. Framework-agnostic (Web Fetch Request -> Response); mounted by tala-web.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./kernel": "./src/kernel/types.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "dev": "tsx watch src/dev-server.ts"
  },
  "dependencies": {
    "@hiraia/tala-core": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.29",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
