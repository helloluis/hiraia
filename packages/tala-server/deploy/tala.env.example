# /etc/tala/tala.env — root:root, mode 600, OUTSIDE the repository. Names only here; never commit values.
TALA_ENV=production
TALA_PUBLIC_ORIGIN=https://tala.hiraia.org
TALA_DB_PATH=/var/lib/tala/tala.db
TALA_DOWNLOAD_DIR=/var/www/tala-download
TALA_TRUSTED_PROXY_HOPS=1

# Sign-in
TALA_FEATURE_GOOGLE_SIGNIN=0
# Stop-gap until a mail provider exists: accounts are treated as verified at sign-up.
TALA_AUTH_AUTO_VERIFY=1

# Models — direct provider APIs only
DEEPSEEK_API_KEY=
ALIBABACLOUD_API_KEY=
TALA_LLM_PRIMARY_MODEL=deepseek-flash
TALA_LLM_FALLBACK_MODEL=qwen-flash
TALA_LLM_PRIMARY_INPUT_USD_PER_MILLION=0.30
TALA_LLM_PRIMARY_OUTPUT_USD_PER_MILLION=1.20
TALA_LLM_FALLBACK_INPUT_USD_PER_MILLION=0.30
TALA_LLM_FALLBACK_OUTPUT_USD_PER_MILLION=1.20
# Learners' names never go to a cloud model
TALA_ROSTER_LLM_ROUTE=rules

# Spend controls
TALA_QUOTA_FULL_PER_DAY=5
TALA_QUOTA_SECTION_PER_DAY=15
TALA_BUDGET_MONTHLY_USD=20
TALA_BUDGET_ALERT_USD=10

# Teaching packs (read-only data installed by packages/tala-packs/scripts/stage-for-deploy.sh, see README)
TALA_PACKS_LIBRARY_DIR=/var/lib/tala/packs/science-bow-2026
TALA_PACKS_ARTIFACTS_DIR=/var/lib/tala/packs/artifacts
# Who may open draft packs in production: emails, comma-separated…
TALA_PACK_REVIEWERS=
# …or every signed-in account (early preview; drafts stay labelled as drafts). Unset = allowlist only.
TALA_PACK_DRAFT_PREVIEW=signed-in
