# QVAC's on-device worker is bundled by bare-pack, which does flat, npm-style
# module resolution. It must reach (a) the bare-* runtime polyfills that
# @qvac/sdk imports without declaring (bare-process, bare-fs, …) and (b) the
# @qvac/* native engine packages (embed-llamacpp, llm-llamacpp, …) plus their
# holepunch deps. pnpm's isolated store hides all of these, so flatten the tree
# to a root node_modules. Required for `expo prebuild` / EAS to build the
# worker bundle. See packages/mobile/BUILD.md.
shamefully-hoist=true
